<%@page pageEncoding="UTF-8"%>
<%-- Phần CUỐI dùng chung của trang Hướng dẫn sử dụng -- xem _top.jspf. --%>
        </main>
    </div>
    <script>
        // Mục lục dựng từ chính các tiêu đề h2/h3 có id: viết nội dung xong là
        // có mục lục, không phải khai hai nơi rồi để chúng lệch nhau.
        (function () {
            var toc = document.getElementById('guideToc');
            var links = [];
            document.querySelectorAll('#guideContent h2[id], #guideContent h3[id]').forEach(function (h) {
                var a = document.createElement('a');
                a.href = '#' + h.id;
                a.textContent = h.textContent;
                if (h.tagName === 'H3') {
                    a.className = 'sub';
                }
                toc.appendChild(a);
                links.push({ a: a, h: h });
            });
            // Tô sáng mục đang đọc = tiêu đề CUỐI CÙNG đã cuộn qua mép trên (dưới
            // thanh trên). Không dùng IntersectionObserver: nó chỉ báo khi tiêu
            // đề đi QUA dải theo dõi, nên bấm mục lục nhảy thẳng tới giữa một
            // mục dài là mục lục vẫn sáng mục cũ.
            var pending = false;
            var shown = null;
            function highlight() {
                pending = false;
                // Tiêu đề đã lên tới 1/3 trên màn hình là người đọc đã vào mục đó.
                var line = Math.max(110, window.innerHeight * 0.35);
                var current = links.length ? links[0] : null;
                links.forEach(function (l) {
                    if (l.h.getBoundingClientRect().top <= line) {
                        current = l;
                    }
                });
                links.forEach(function (l) { l.a.classList.toggle('active', l === current); });
                // Mục lục dài hơn màn hình (Hợp đồng có hơn 30 mục) thì cuộn CHÍNH
                // mục lục cho mục đang sáng lọt vào tầm nhìn -- không thì đọc tới
                // cuối trang mà mục lục vẫn đứng ở đầu, không thấy mình ở đâu. Chỉ
                // cuộn khi mục đang sáng vừa ĐỔI, để không giành tay người đang tự
                // cuộn mục lục. Tính bằng scrollTop chứ không dùng scrollIntoView:
                // cái đó cuộn luôn cả trang.
                if (current && current !== shown) {
                    shown = current;
                    var top = current.a.offsetTop;
                    var bottom = top + current.a.offsetHeight;
                    if (top < toc.scrollTop + 40) {
                        toc.scrollTop = Math.max(0, top - 40);
                    } else if (bottom > toc.scrollTop + toc.clientHeight - 20) {
                        toc.scrollTop = bottom - toc.clientHeight + 20;
                    }
                }
            }
            window.addEventListener('scroll', function () {
                if (!pending) {
                    pending = true;
                    window.requestAnimationFrame(highlight);
                }
            }, { passive: true });
            highlight();
        })();
    </script>
</body>
</html>
