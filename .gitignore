# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Vendored build dependencies are intentionally committed for
# reproducible builds across machines.
!/lib/*.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
/build/
/dist/

# NetBeans private project state (machine-specific: IDE server paths,
# open editor tabs, etc.) - should never be shared between developers.
/nbproject/private/

# Backup files NetBeans/Ant leave behind when regenerating build-impl.xml
*.xml~
